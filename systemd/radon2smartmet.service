[Unit]

Description=Smartmet RADON to REDIS daemon

# Order after a local key-value store if one is installed. Both names are
# listed so that either Redis or Valkey works; ordering dependencies on
# units that do not exist are silently ignored by systemd.
#
# This is deliberately *not* a Requires=: the content server backend is
# selected in the configuration file (redis / postgresql / http / corba) and
# may well be on another host. Restart=always below takes care of the case
# where the backend is not yet accepting connections at startup.
#
# If your site does want a hard dependency, add a drop-in instead of editing
# this file, e.g. /etc/systemd/system/radon2smartmet.service.d/kvstore.conf:
#     [Unit]
#     Requires=valkey.service
#     After=valkey.service
After=redis.service valkey.service
 
[Service]

# Not a real daemon
Type=simple

EnvironmentFile=/etc/smartmet/radon2smartmet.env

ExecStart=/usr/bin/fmi/radon2smartmet ${CONFIG} 300

LimitCORE=infinity

# Do not retry too fast if there are some I/O or similar issues
Restart=always
RestartSec=5s

# We do not signal completion to systemd
TimeoutStartSec=0

# Wait for 30s for the server to stop before sending SIGTERM and another 30s before SIGKILL
TimeoutStopSec=30s

LimitNOFILE=999999999
 
[Install]

WantedBy=multi-user.target
